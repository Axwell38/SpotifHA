{
  "name": "spotifha",
  "version": "0.1.0",
  "type": "module",
  "description": "Contrôle Spotify complet depuis le Quick Access Menu du Steam Deck",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": ["decky-plugin", "spotify"],
  "author": "Axwell38",
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.22.5",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
